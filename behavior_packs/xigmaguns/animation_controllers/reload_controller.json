{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.reload": {
			"initial_state": "default",
			"states": {
				"default": {
                    "on_entry": [
						"/scriptevent xg:reload",
                        "/event entity @s remove_reloading"
					],
					"transitions": [
                        {
                            "reload": "query.is_sneaking&&query.is_alive&&variable.attack_time"
                        }
					]
				},
				"reload": {
					"on_entry": [
						"/scriptevent xg:reload",
                        "/event entity @s add_reloading"
					],
					"transitions": [
						{
							"default": "!variable.attack_time"
						}
					]
				}
			}
		}
    }
}