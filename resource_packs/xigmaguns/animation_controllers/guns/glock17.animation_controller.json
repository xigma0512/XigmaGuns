{
    "format_version": "1.20.0",
    "animation_controllers": {
        "controller.animation.item.fpp_glock17": {
            "initial_state": "fpp_default",
            "states": {
                "fpp_default": {
                    "animations": [
                        "fpp_hold"
                    ],
                    "transitions": [
                        { "draw": "1" }
                    ]
                },
                "draw": {
                    "animations": [
                        "draw"
                    ],
                    "transitions": [
                        { "hold": "q.all_animations_finished" },
                        { "reload": "c.owning_entity->q.property('gun:is_reloading')" }
                    ]
                },
                "reload": {
                    "animations": [
                        "reload"
                    ],
                    "transitions": [
                        { "hold": "q.all_animations_finished" }
                    ]
                },
                "hold": {
                    "animations": [
                        "fpp_hold"
                    ],
                    "transitions": [
                        { "reload": "c.owning_entity->q.property('gun:is_reloading')" }
                    ]
                }
            }
        },
        "controller.animation.item.tpp_glock17": {
            "initial_state": "tpp_default",
            "states": {
                "tpp_default": {
                    "animations": [
                        "tpp_hold"
                    ]
                }
            }
        }
    }
}