{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "minecraft:player",
            "spawn_category": "creature",
            "is_spawnable": false,
            "is_summonable": false,
            "scripts": {
                "animate": [
                    "reload",
                    "movement"
                ]
            },
            "animations": {
                "reload": "controller.animation.reload",
                "movement": "controller.animation.movement"
            }
        },
        "component_groups": {
            "throwing_smoke_grenade": {
                "minecraft:spawn_entity": {
                    "entities": [
                        {
                            "filters": [
                                {
                                    "test": "is_sneaking",
                                    "operator": "==",
                                    "value": false
                                }
                            ],
                            "min_wait_time": 0,
                            "max_wait_time": 0,
                            "single_use": true,
                            "spawn_entity": "xigmaguns:smoke_grenade",
                            "spawn_event": "set_overhand",
                            "num_to_spawn": 1
                        },
                        {
                            "filters": [
                                {
                                    "test": "is_sneaking",
                                    "operator": "==",
                                    "value": true
                                }
                            ],
                            "min_wait_time": 0,
                            "max_wait_time": 0,
                            "single_use": true,
                            "spawn_entity": "xigmaguns:smoke_grenade",
                            "spawn_event": "set_underhand",
                            "num_to_spawn": 1
                        }
                    ]
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "player"
                ]
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.8
            },
            "minecraft:can_climb": {},
            "minecraft:attack": {
                "damage": 0
            },
            "minecraft:nameable": {
                "always_show": false,
                "allow_name_tag_renaming": false
            },
            "minecraft:physics": {
                "push_towards_closest_space": true
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:block_climber": {}
        },
        "events": {
            "throwing_smoke_grenade": {
                "add": {
                    "component_groups": [
                        "throwing_smoke_grenade"
                    ]
                }    
            }
        }
    }
}