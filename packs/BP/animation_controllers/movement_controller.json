{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.movement": {
            "initial_state": "stop_moving",
            "states": {
                "stop_moving": {
                    "on_entry": [
                        "/scriptevent xigmaguns:stop_moving"
                    ],
                    "transitions": [
                        {
                            "moving": "query.is_moving"
                        }
                    ]
                },
                "moving": {
                    "on_entry": [
                        "/scriptevent xigmaguns:moving"
                    ],
                    "transitions": [
                        {
                            "stop_moving": "!query.is_moving"
                        }
                    ]
                }
            }
        }
    }
}